# secrets
.env

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# runtime output
logs/
site/screenshots/

# MCA cache -- regenerated by T4.3, ~24k records, not source of truth
data/mca_foreign_subs.json

# init.sh's smoke output. Fixture-derived, so it must never be mistaken for the
# published artifact -- which is exactly why the smoke build writes here and not
# to data/companies.json.
data/companies.smoke.json

# The half-written file a killed build leaves behind (T6.4). companies.json is
# written to a sibling and renamed over, so an interrupted run leaves this rather
# than a truncated site.
data/*.json.tmp

# NOTE: data/companies.json IS committed on purpose. The nightly commit history
# of that file IS the time series that feature 13 (hiring velocity) reads via
# `git log`. Never add it here.

.DS_Store

# gstack tooling state, not project content
.gstack/

# Agent worktrees. `git worktree add` puts them INSIDE the repo, so without this
# they are untracked-but-scanned: `ruff check .` walks into another agent's
# half-written code and fails the gate on a file this checkout does not own.
# Measured that way -- a lint error in a sibling agent's src/net.py.
.claude/worktrees/
