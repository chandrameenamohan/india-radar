# Copy to .env and paste your key. .env is gitignored -- never commit the real one.
# Get it from https://www.data.gov.in/user/register (free, instant, no approval queue)
DATA_GOV_IN_KEY=
# Companies House, for the UK registration badge (T9.1). Free, instant.
# https://developer.company-information.service.gov.uk/ -- it is HTTP Basic's
# USERNAME with an empty password, not a query parameter.
UK_COMPANY_HOUSE_KEY=
